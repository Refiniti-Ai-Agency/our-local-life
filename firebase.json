{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "dist/**",
      "_firebase-live-sync/**",
      "_firebase-live/**",
      "turfflex/**",
      "tanner-website/**",
      "our-local-life/**",
      "our-local-life/**",
      "scripts/**",
      "turfflex/**",
      "tanner-website/**",
      "docs/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/hub",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/hub/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/hub",
        "destination": "/hub.html"
      }
    ],
    "redirects": [
      {
        "source": "/pages/blog/meet-atma-erice-the-practice-of-presence.html",
        "destination": "/pages/stories/the-practice-of-presence-inside-atmas-approach-to-healing.html",
        "type": 301
      },
      {
        "source": "/blog/meet-atma-erice-the-practice-of-presence",
        "destination": "/pages/stories/the-practice-of-presence-inside-atmas-approach-to-healing.html",
        "type": 301
      },
      {
        "source": "/pages/blog/meet-dustin-defrates-builder-of-people-places-purpose.html",
        "destination": "/pages/stories/dustin-defrates-building-people-places-purpose.html",
        "type": 301
      },
      {
        "source": "/blog/meet-dustin-defrates-builder-of-people-places-purpose",
        "destination": "/pages/stories/dustin-defrates-building-people-places-purpose.html",
        "type": 301
      },
      {
        "source": "/pages/blog/meet-lai-lam-intentional-dating-resumate.html",
